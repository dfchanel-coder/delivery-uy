{
  "name": "@deliveryuy/api",
  "version": "0.0.0",
  "private": true,
  "description": "DeliveryUY backend API (NestJS modular monolith)",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "start:debug": "node --inspect dist/main.js",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@deliveryuy/auth": "workspace:*",
    "@deliveryuy/config": "workspace:*",
    "@deliveryuy/database": "workspace:*",
    "@deliveryuy/notifications": "workspace:*",
    "@deliveryuy/storage": "workspace:*",
    "@deliveryuy/types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@deliveryuy/typescript-config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
