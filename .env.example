# DeliveryUY - example environment file
#
# Copy to `.env` and replace every CHANGE_ME value before starting the API.
# This file is the documented mirror of packages/config/src/environment.ts:
# if a key is missing here, the schema still requires it.
#
# AGENTS.md sections 30 and 61: never commit real secrets.

# --- runtime -----------------------------------------------------------------
APP_ENV=development
NODE_ENV=development
SERVICE_NAME=api

# --- http --------------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000
API_INTERNAL_PORT=3001
API_BODY_LIMIT=1mb
# Comma separated list of allowed browser origins (admin panel, local tools).
# The admin panel runs on http://localhost:4000 (see apps/admin/package.json).
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# --- infrastructure ----------------------------------------------------------
DATABASE_URL=postgresql://delivery:delivery@localhost:5432/deliveryuy
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

# --- security ----------------------------------------------------------------
# Minimum 32 characters each, and they must differ from each other.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=deliveryuy
JWT_AUDIENCE=deliveryuy-clients
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_MIN_LENGTH=10

# --- delivery verification code (ADR-010) ------------------------------------
DELIVERY_CODE_LENGTH=6
DELIVERY_CODE_NUMERIC_ONLY=true
DELIVERY_CODE_TTL_HOURS=24
DELIVERY_CODE_MAX_ATTEMPTS=5
DELIVERY_CODE_LOCK_MINUTES=15

# --- dispatch engine (ADR-015) ----------------------------------------------
DISPATCH_STRATEGY=proximity-v1
DISPATCH_BATCH_SIZE=5
DISPATCH_OFFER_TTL_SECONDS=45
DISPATCH_MAX_ROUNDS=10
CROSS_CITY_DISPATCH=false

# --- realtime and GPS (ADR-012) ---------------------------------------------
GPS_INTERVAL_SECONDS=5
GPS_POSITION_TTL_SECONDS=120
GPS_HISTORY_ENABLED=false
GPS_HISTORY_RETENTION_HOURS=24

# --- platform defaults -------------------------------------------------------
# No city is hardcoded anywhere (AGENTS.md section 45); these are only the
# defaults used when a city record does not define them explicitly.
DEFAULT_COUNTRY=UY
DEFAULT_CURRENCY=UYU
DEFAULT_TIMEZONE=America/Montevideo
RUNTIME_CONFIG_CACHE_TTL_SECONDS=30
SESSION_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7
WEBHOOK_EVENT_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=7

# --- map provider (ADR-005) --------------------------------------------------
# none | google | mapbox | openstreetmap
MAP_PROVIDER=none
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# --- payment provider (ADR-003) ----------------------------------------------
# none | mercadopago | cash
PAYMENT_PROVIDER=none
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --- billing provider (LEGAL_REVIEW_REQUIRED) -------------------------------
# none | cfe | external
BILLING_PROVIDER=none

# --- notification provider ---------------------------------------------------
# none | fcm | smtp
NOTIFICATION_PROVIDER=none
FIREBASE_PROJECT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- storage provider --------------------------------------------------------
# local is rejected when APP_ENV is staging or production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./var/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# --- observability (ADR-014) -------------------------------------------------
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- feature flags default state (ADR-013) -----------------------------------
FEATURE_CASH_PAYMENTS=false
FEATURE_WALLET=false
FEATURE_TIPS=false
FEATURE_SCHEDULED_ORDERS=false
FEATURE_LOYALTY=false
FEATURE_MULTI_ORDER_DELIVERY=false