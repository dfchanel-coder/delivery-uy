# Normalise line endings so Windows and Linux checkouts produce identical
# diffs (a Flutter, NestJS and Next.js monorepo is edited on all three).
* text=auto eol=lf

# Windows batch files need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper script stays LF even on Windows (POSIX CI invokes it through sh).
gradlew text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.pem binary