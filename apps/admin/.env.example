# Admin panel configuration.
# Copy to apps/admin/.env.local (git ignored) and adjust.
# Every key is validated at startup; an invalid value fails the boot loudly.

# Base URL of the DeliveryUY API, without the /api/v1 suffix.
API_URL=http://localhost:3000

# Abort the API request after this many milliseconds (500 - 30000).
API_TIMEOUT_MS=5000

# Panel title rendered in the masthead and page metadata.
ADMIN_PANEL_NAME=DeliveryUY Admin