{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "DeliveryUY tooling (vitest/ESLint entry points)",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../vitest.config.ts"]
}
