# Docker infrastructure variables (development only).
#
# Copy to infrastructure/docker/.env.docker and adjust if a port is taken.
# Real production credentials are never stored in the repository
# (AGENTS.md sections 30 and 62).

POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery
POSTGRES_DB=deliveryuy
POSTGRES_PORT=5432

REDIS_PORT=6379

# Test stack ports. They differ from the development ones on purpose so both
# stacks can run at the same time: `pnpm infra:up` for the application while
# `pnpm infra:test` serves the integration suite.
TEST_POSTGRES_PORT=5433
TEST_REDIS_PORT=6380