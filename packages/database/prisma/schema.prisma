// DeliveryUY - Prisma schema
//
// PHASE 01 establishes the Prisma toolchain and connection only.
// The entity model is designed in docs/ERD.md and proposed in
// docs/SCHEMA_PROPOSAL.md; migration 0001_init is created in PHASE 02.
//
// Do not add models ad hoc: schema changes follow DATABASE.md section 66 and
// require a migration, index review and constraint review.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}