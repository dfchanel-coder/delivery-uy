{
  "name": "@deliveryuy/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma client and data access helpers. PostgreSQL is the source of truth (ADR-009).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "build": "pnpm run prisma:generate && tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@deliveryuy/typescript-config": "workspace:*",
    "prisma": "^6.2.0"
  }
}
